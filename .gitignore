.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json
*.code-workspace

# JetBrains (WebStorm, PyCharm, CLion, IntelliJ IDEA и др.)
.idea/
*.iws

# ==========================================
# 🔒 ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ (Секреты)
# ==========================================
# Скрываем файлы настроек .env, чтобы не утекли пароли бд (например, из Prisma)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# Оставляем только шаблон для других разработчиков
!.env.example

