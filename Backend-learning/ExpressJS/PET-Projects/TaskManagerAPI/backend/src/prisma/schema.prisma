generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id Int @id @default(autoincrement()) // Числовой ID, который увлечивается автоматически (+1)
  email String @unique                  // Строконое обязательное поле
  password String                      // Строконое обязательное поле
  tasks Task[]
  createdAt DateTime @default(now())   // Автоматически ставит текущую дату создания
}

model Task {
  id Int @id @default(autoincrement()) // Числовой ID, который увлечивается автоматически (+1)
  title String                         // Строковое обязательное поле
  description String?                  // Знак вопроса означает, что поле не обязательно (может быть null)
  isCompleted Boolean @default(false)  // Булевое поле, по умолчанию false
  createdAt DateTime @default(now())   // Автоматически ставит текущую дату создания

  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}