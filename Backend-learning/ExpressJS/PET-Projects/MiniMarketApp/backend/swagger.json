{
  "openapi": "3.0.4",
  "info": {
    "title": "Mini Market API",
    "description": "PET-Project с сервером написанным на Express.js.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000/api",
      "description": "Локальный сервер для разработки"
    }
  ],
  "tags": [
    {
      "name": "Health",
      "description": "Операция отклика сервера"
    },
    {
      "name": "User",
      "description": "Операции с пользователем"
    },
    {
      "name": "Products",
      "description": "Операции с товарами"
    },
    {
      "name": "Category",
      "description": "Операции с категориями (АДМИН)"
    },
    {
      "name": "Cart",
      "description": "Операции с корзиной пользователя"
    },
    {
      "name": "Order",
      "description": "Операции с заказами"
    },
    {
      "name": "Analytics",
      "description": "Операции с аналитикой (АДМИН)"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health запрос на отклик сервера",
        "description": "Простой HTTP GET запрос к серверу, чтобы проверить его доступность и работоспособность.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Health GET запрос",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "default": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "tags": [
          "User"
        ],
        "summary": "Регистрация пользователя",
        "description": "Отправляет POST запрос к БД с данными: почта, пароль. Система проверяет валидность данных, при успехе выдает роль \"посетителя\", оставляя данные в базе.",
        "operationId": "registerUser",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Запрос выполнен успешно!",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "422": {
            "description": "Validation exception"
          },
          "default": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "User"
        ],
        "summary": "Авторизация пользователя",
        "description": "Отправляет POST запрос к БД с данными: почта, пароль. Система проверяет валидность данных, сравнивает хэши паролей и jwt токен. При успехе предоставляет доступ пользователю и выдает новые jwt токены.",
        "operationId": "loginUser",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Запрос выполнен успешно!",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorizared error"
          },
          "default": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": [
          "User"
        ],
        "summary": "Обновление токена из кэша",
        "description": "Отправляет POST запрос к Redis с refresh токеном для выдачи новой пары jwt токенов: accessToken(expire: 15m), refreshToken(expire: 7d). Первый длится 15 минут, после чего данный запрос проверяет старый refresh токен, который валиден 7 дней. При успехе выдает новую пару на следующие временные сессии.",
        "operationId": "refreshToken",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserRefreshRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Запрос выполнен успешно!",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserRefreshResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorizared error"
          },
          "default": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": [
          "User"
        ],
        "summary": "Выход пользователя из аккаунта",
        "description": "Отправляет POST запрос к Redis с ID пользователя, чтобы инвалидировать jwt токены и выйти из аккаунта.",
        "operationId": "logoutUser",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserLogoutRequest"
              }
            }
          },
          "required": false
